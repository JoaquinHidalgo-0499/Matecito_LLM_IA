# =========================================================================
# braind - Plantilla de Configuración de Entorno (.env.example)
# =========================================================================
# Copia este archivo como .env en la raíz del workspace para personalizar rutas:
#   cp .env.example .env
#
# Si no creas .env, el sistema usará automáticamente los valores por defecto
# (Zero-Config: busca '../material-academico' en la carpeta hermana).
# =========================================================================

# Ruta hacia el repositorio de material académico de cátedra (apuntes, libros, parciales)
# Puede ser una ruta relativa respecto a la raíz de braind/ o una ruta absoluta.
MATERIAL_ACADEMICO_PATH="../material-academico"

# Dirección IP o nombre de host del servidor personal / Homelab
HOMELAB_SERVER_IP="192.168.20.200"
