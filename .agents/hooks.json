{
  "autofix-wikilinks-formatting": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 fix_backticks.py"
          }
        ]
      }
    ]
  },
  "protect-readonly-repos": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 protect_readonly.py"
          }
        ]
      }
    ]
  }
}
