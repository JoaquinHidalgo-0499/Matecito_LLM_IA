{
  "autofix-wikilinks-formatting": {
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "shell",
            "command": "python3 .agents/fix_backticks.py"
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "shell",
            "command": "python3 .agents/fix_backticks.py"
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "shell",
            "command": "python3 .agents/fix_backticks.py"
          }
        ]
      }
    ]
  },
  "protect-readonly-repos": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/protect_readonly.py"
          }
        ]
      }
    ]
  }
}
